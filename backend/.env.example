# Copy this file to .env and fill in real values. Never commit .env itself,
# per docs/12-project-architecture.md#secrets-management.

NODE_ENV=development
PORT=3000

# --- Database -----------------------------------------------------------
# Local (non-Docker) development: host is "localhost".
# Running via docker/docker-compose.yml: host is "postgres" (the service
# name), since the backend container reaches Postgres over the compose
# network, not localhost.
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public"

# --- JWT (RS256) ----------------------------------------------------------
# Generate a local dev key pair with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Then paste each PEM's contents below with literal "\n" line breaks, e.g.:
#   JWT_ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
JWT_ACCESS_TOKEN_PRIVATE_KEY=""
JWT_ACCESS_TOKEN_PUBLIC_KEY=""
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- Password hashing -----------------------------------------------------
# bcrypt cost factor. Higher = slower to hash/verify but more resistant to
# brute force; 12 is a reasonable default for current hardware.
BCRYPT_SALT_ROUNDS=12

# --- AI (Sprint 18A — AI Foundation, Sprint 18B — First AI Capabilities) --
# Everything below has a safe default (see src/config/env.validation.ts) —
# the app boots fine with none of these set. GEMINI_API_KEY/OPENROUTER_API_KEY
# are the two exceptions worth filling in: without a key, that provider's
# isAvailable() returns false and ProviderRouter simply routes around it —
# with NEITHER key set, any /ai/... endpoint call fails with a clear
# ProviderUnavailableException, but the app itself still starts normally.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Which registered provider id ProviderRouter uses by default.
AI_DEFAULT_PROVIDER=gemini
# Comma-separated provider ids ProviderRouter is allowed to select from.
AI_ENABLED_PROVIDERS=gemini,openrouter
# Comma-separated provider ids, most-preferred first — see ProviderRouter.resolveChain.
AI_PROVIDER_PRIORITY=gemini,openrouter
# When true, AiFallbackExecutor tries the next provider in AI_PROVIDER_PRIORITY
# after the current one's own retries (AI_RETRY_COUNT) are exhausted.
AI_FALLBACK_ENABLED=false
# "feature=providerId,feature2=providerId2" — e.g. "travel=openrouter" always
# tries OpenRouter first for /ai/travel/suggest, regardless of AI_PROVIDER_PRIORITY.
# See ProviderRouter.resolveChain. Empty = no override, priority order only.
AI_FEATURE_PROVIDER_OVERRIDES=

# Gemini generation parameters — all overridable per-call via AiGenerateOptions.
AI_MODEL=gemini-2.0-flash
# OpenRouter model slug — see https://openrouter.ai/models for the full catalog.
AI_OPENROUTER_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_TOP_K=40
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=15000
AI_RETRY_COUNT=2
